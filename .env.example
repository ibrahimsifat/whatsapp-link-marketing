# =============================================================================
# Cloudflare D1
# =============================================================================
# Find the account ID in the Cloudflare dashboard sidebar (Workers & Pages).
CLOUDFLARE_ACCOUNT_ID=

# Printed by `wrangler d1 create <name>`, or shown on the database's page under
# Storage & Databases -> D1.
CLOUDFLARE_D1_DATABASE_ID=

# Create at My Profile -> API Tokens -> Create Token.
# Permissions required: Account -> D1 -> Edit
CLOUDFLARE_API_TOKEN=

# =============================================================================
# Authentication (single hard-coded operator)
# =============================================================================
AUTH_EMAIL=admin@example.com

# Preferred: the SHA-256 hash of the password, so the plaintext never sits in
# an env file or a deployment dashboard.
#   node scripts/hash-password.mjs "your-password"
AUTH_PASSWORD_HASH=

# Fallback, used only when AUTH_PASSWORD_HASH is empty. Convenient for local
# development; prefer the hash in production.
AUTH_PASSWORD=

# Signing key for session tokens. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing this value invalidates every existing session.
JWT_SECRET=

# Session lifetime in seconds. Default: 604800 (7 days).
SESSION_MAX_AGE=604800

# =============================================================================
# Tuning (optional — sensible defaults apply when omitted)
# =============================================================================
# Timeout for a single D1 HTTP call, in milliseconds.
D1_TIMEOUT_MS=15000

# Retries for transient D1 failures (0-5).
D1_MAX_RETRIES=2

# Set to "true" to log every SQL statement to the server console.
DB_LOGGING=false
